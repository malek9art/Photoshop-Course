# Required: pooled PostgreSQL connection string. Use a Vercel/Neon/Supabase
# pooled connection endpoint in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Leave enabled in production. For a local PostgreSQL server without TLS use false.
DATABASE_SSL=true
# Set true only when your provider supplies a CA trusted by this runtime.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Conservative per-serverless-instance pool settings.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
